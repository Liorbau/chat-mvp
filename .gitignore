.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Legacy snapshots kept only for local reference.
apps/web/legacy/

# Emitted declaration files from ad-hoc tsc runs over the eval scripts (eval is
# excluded from the Nest build; these are never source).
apps/api/eval/**/*.d.ts
