PORT=4000
CORS_ORIGIN=http://localhost:5173

# Required: secret used to sign and verify JWTs. Must be at least 32 characters.
# The app fails to start if unset or too short.
JWT_SECRET=change-me-in-local-and-prod-min-32-chars
# Optional: JWT lifetime (vercel/ms format). Defaults to 1h.
JWT_EXPIRES_IN=1h
# Required: bcrypt cost factor for password hashing (use 10-12 in production).
# The app fails to start if unset.
BCRYPT_ROUNDS=12

# Required: MongoDB connection string. The app fails to start if unset.
# Uses a replica set (rs0) so multi-document transactions work (see
# docker-compose.yml). Atlas clusters are already replica sets.
MONGO_URI=mongodb://localhost:27017/chat?replicaSet=rs0

# Which LLM backs the assistant: 'openai' or 'anthropic'. Defaults to 'openai'.
# Swapping providers is just this var — no code change.
LLM_PROVIDER=openai
# Required only for the selected provider (the app fails to start if its key is
# missing). Never commit a real key.
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: model id override. When unset, each provider uses its own default
# (openai -> gpt-4o, anthropic -> claude-opus-4-8).
LLM_MODEL=
# Optional: max output tokens per assistant reply. Defaults to 2048.
LLM_MAX_TOKENS=2048
