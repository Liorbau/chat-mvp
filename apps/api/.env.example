PORT=4000
CORS_ORIGIN=http://localhost:5173

# Required: secret used to sign and verify JWTs. Must be at least 32 characters.
# The app fails to start if unset or too short.
JWT_SECRET=change-me-in-local-and-prod-min-32-chars
# Optional: JWT lifetime (vercel/ms format). Defaults to 1h.
JWT_EXPIRES_IN=1h
# Required: bcrypt cost factor for password hashing (use 10-12 in production).
# The app fails to start if unset.
BCRYPT_ROUNDS=12

# Required: MongoDB connection string. The app fails to start if unset.
# Week 7+: MongoDB Atlas is required (local Mongo has no Vector Search). Use the
# Atlas SRV string — already a replica set, so multi-document transactions work
# without a ?replicaSet suffix. Append the db name (e.g. /chat). The test suite
# overrides this with a local docker URI (docker-compose.yml), so tests never hit
# Atlas.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.xxxxx.mongodb.net/chat?retryWrites=true&w=majority

# Which LLM backs the assistant: 'openai' or 'anthropic'. Defaults to 'openai'.
# Swapping providers is just this var — no code change.
LLM_PROVIDER=openai
# Required only for the selected provider (the app fails to start if its key is
# missing). Never commit a real key.
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: model id override. When unset, each provider uses its own default
# (openai -> gpt-4o, anthropic -> claude-opus-4-8).
LLM_MODEL=
# Optional: max output tokens per assistant reply. Defaults to 2048.
LLM_MAX_TOKENS=2048

# --- Week 7: AI Tutor (RAG) ---
# Required: Voyage AI key for document/query embeddings (free tier covers this
# project). Never commit a real key.
VOYAGE_API_KEY=pa-your-voyage-key-here
# Name of the Atlas Vector Search index on the kb_chunks collection. Create it
# once in the Atlas UI from atlas/vector-index.json; this must match that name.
VECTOR_INDEX_NAME=kb_chunks_vector

# --- Week 8: LangGraph Agent ---
# No new secrets: the MongoDB checkpoint saver reuses MONGO_URI and the agent's
# chat model reuses the LLM_PROVIDER / OPENAI_API_KEY / ANTHROPIC_API_KEY above.

# --- Avatar object storage (S3-compatible; set STORAGE_S3_ENDPOINT for non-AWS) ---
# Never commit real credentials.
# Public CDN base URL avatars are served from (no trailing slash).
# Supabase: https://<projectRef>.supabase.co/storage/v1/object/public/<bucket>
# AWS: the CloudFront distribution domain.
STORAGE_PUBLIC_BASE_URL=https://<projectRef>.supabase.co/storage/v1/object/public/avatars

# Supabase: region + S3 access keys are on the Storage → S3 settings page.
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=your-s3-access-key-id
STORAGE_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
STORAGE_S3_BUCKET=avatars
# S3-compatible endpoint (used server-side; no browser CORS involved).
# Supabase: https://<projectRef>.storage.supabase.co/storage/v1/s3
# Leave UNSET only for real AWS S3.
STORAGE_S3_ENDPOINT=https://<projectRef>.storage.supabase.co/storage/v1/s3

# --- Email change (confirmed flow) ---
# Required: separate secret to sign the short-lived email-change confirm token
# (min 32 chars). Kept distinct from JWT_SECRET so a confirm token can never be
# replayed as a login token. Never commit a real secret.
EMAIL_CHANGE_TOKEN_SECRET=change-me-different-from-jwt-min-32-chars
# Optional: confirm-link lifetime (vercel/ms format). Defaults to 30m.
EMAIL_CHANGE_TOKEN_TTL=30m
# Optional: public web-app URL used to build the confirmation link. Defaults to
# http://localhost:5173. In production set your real site URL (no trailing slash).
WEB_APP_URL=http://localhost:5173
# Which email backend sends the confirmation: 'log' (prints the link to the server
# console — dev, no AWS needed) or 'ses' (AWS SES). Defaults to 'log'.
EMAIL_PROVIDER=log
# Required only when EMAIL_PROVIDER=ses. AWS credentials are read from the standard
# AWS SDK chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env or an IAM role).
EMAIL_SES_REGION=us-east-1
# Verified SES sender address.
EMAIL_FROM=no-reply@yourdomain.com
